# EvalLoop metastore (runs, results, manifests, LLM cache)
EVALLOOP_DATABASE_URL=postgresql+psycopg://evalloop:evalloop@localhost:5433/evalloop

# Artifact store (traces + results as parquet, model artifacts, bundles)
EVALLOOP_ARTIFACT_ROOT=./artifacts

# Judge provider - any OpenAI-compatible endpoint (OpenAI, vLLM, Together, Groq, LiteLLM proxy)
EVALLOOP_JUDGE_BASE_URL=https://api.openai.com/v1
EVALLOOP_JUDGE_API_KEY=

# Optional: Anthropic provider
ANTHROPIC_API_KEY=

# Source database being evaluated - READ ONLY, use a role with SELECT only
EVALLOOP_SOURCE_DATABASE_URL=postgresql+psycopg://readonly:readonly@localhost:5434/product
